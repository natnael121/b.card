rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Users can upload/manage files in their own folder
    match /users/{userId}/{allPaths=**} {
      // Anyone can read (needed for public card display)
      allow read: if true;

      // Only the owner can write
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 15 * 1024 * 1024; // 15 MB max per file
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
