rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profiles collection - users can create and read their own profile
    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false; // Profiles cannot be deleted
    }

    // Business cards collection
    match /business_cards/{cardId} {
      allow read: if true; // Anyone can read active cards
      allow create: if request.auth != null
        && validatePortfolioImages();
      allow update: if request.auth != null && (
        resource.data.user_id == request.auth.uid ||
        (resource.data.admin_emails != null && request.auth.token.email in resource.data.admin_emails)
      ) && validatePortfolioImages();
      allow delete: if request.auth != null && resource.data.user_id == request.auth.uid;

      // Ensure portfolio_images never exceeds 10 items
      function validatePortfolioImages() {
        return !('portfolio_images' in request.resource.data)
            || request.resource.data.portfolio_images.size() <= 10;
      }
    }

    // Contact shares collection
    match /contact_shares/{shareId} {
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/business_cards/$(resource.data.card_id)) &&
        get(/databases/$(database)/documents/business_cards/$(resource.data.card_id)).data.user_id == request.auth.uid;
      allow create: if true; // Anyone can share their contact
      allow update, delete: if false; // Cannot modify or delete shares
    }

    // Analytics events collection
    match /analytics_events/{eventId} {
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/business_cards/$(resource.data.card_id)) &&
        get(/databases/$(database)/documents/business_cards/$(resource.data.card_id)).data.user_id == request.auth.uid;
      allow create: if true; // Anyone can create analytics events
      allow update, delete: if false; // Cannot modify or delete events
    }

    // Telegram settings collection
    match /telegram_settings/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Google Calendar Tokens collection
    match /google_calendar_tokens/{cardId} {
      allow read: if true; // Public read is required for visitors to retrieve and refresh tokens client-side
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/business_cards/$(cardId)) &&
        get(/databases/$(database)/documents/business_cards/$(cardId)).data.user_id == request.auth.uid;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
